      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completion cue plays when rest finishes. Auto-start begins rest right after a set is completed. Show overdue keeps the timer visible after zero so you can track extra recovery."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El aviso suena cuando termina el descanso. El inicio automático comienza el descanso justo después de completar una serie. Mostrar tiempo extra mantiene visible el temporizador después de cero para que puedas seguir la recuperación adicional."
          }
        }
      }
    },
