    "settings.units.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weight is converted for display and entry using your selected unit. Cardio distance is stored internally in kilometers and converted in routine planning and workout logging when needed."
