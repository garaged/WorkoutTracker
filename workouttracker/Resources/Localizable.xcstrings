    "health.authorization.message.authorized" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completed tracked activities can be saved to Apple Health. Eligible outdoor routes can be attached when location access is also available."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actividades registradas completadas se pueden guardar en Apple Health. Las rutas exteriores elegibles se pueden adjuntar cuando también hay acceso a la ubicación."
          }
        }
      }
    },
    "health.authorization.message.denied" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WorkoutTracker does not currently have permission to save tracked activities to Apple Health. You can still track locally and enable Apple Health later."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WorkoutTracker no tiene permiso actualmente para guardar actividades registradas en Apple Health. Aun así, puedes registrarlas localmente y habilitar Apple Health después."
          }
        }
      }
    },
    "health.authorization.message.not_requested" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WorkoutTracker can save completed tracked activities to Apple Health. Outdoor walks, runs, and hikes can also include route data when Apple Health and Location access are available."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WorkoutTracker puede guardar actividades registradas completadas en Apple Health. Las caminatas, carreras y senderismos al aire libre también pueden incluir datos de ruta cuando Apple Health y el acceso a Ubicación están disponibles."
          }
        }
      }
    },
    "health.authorization.message.unavailable" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health is not available on this device. Tracked activities still stay in WorkoutTracker locally."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health no está disponible en este dispositivo. Las actividades registradas seguirán guardándose localmente en WorkoutTracker."
          }
        }
      }
    },
